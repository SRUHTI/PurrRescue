<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MyApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/pantone_blue_aster</item>
        <item name="colorOnPrimary">@color/black</item>

        <item name="colorControlActivated">@color/pantone_blue_aster</item>

        <item name="android:windowLightStatusBar">true</item> <!-- dark icons on light status bar -->
    </style>

    <!-- Edit Text -->
    <style name="EditTextFieldOutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/pantone_blue_aster</item>
        <item name="hintTextColor">@color/pantone_blue_aster</item>  <!-- floating -->
        <item name="android:textColorHint">@color/grey</item>      <!-- placeholder -->
    </style>

    <style name="RescueDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/pantone_blue_aster</item>
        <item name="android:background">@color/off_white</item>
        <item name="android:textSize">@dimen/text_large</item>
    </style>

</resources>